# Exemplo de variaveis de ambiente. Copie para .env e ajuste.
# Nunca comite o .env real.

APP_ENV=development

# Banco de desenvolvimento/testes (SQLite inicial; preparado p/ PostgreSQL)
DATABASE_URL=sqlite:///./data/licitacao.db

# Diretório onde os originais dos documentos são armazenados (imutáveis)
DATA_DIR=./data/documentos

LOG_LEVEL=INFO
